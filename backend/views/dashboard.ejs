<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TeamTask — Notes</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Poppins:wght@600;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b0b0c;
      --panel:#0f0f11;
      --muted:#9CA3AF;
      --white:#ffffff;
      --accent:#6c4bd6;
      --cta:#3b82f6;
      --glass: rgba(255,255,255,0.03);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter,system-ui,Arial;
      background:linear-gradient(180deg,var(--bg), #0f0f11);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      min-height:100vh;
    }

    /* Nav */
    header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 40px;
      border-bottom:1px solid rgba(255,255,255,0.03);
      background: rgba(255,255,255,0.01);
    }
    .logo {
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      font-size:20px;
      letter-spacing:-0.02em;
    }
    .nav-actions { display:flex; gap:10px; align-items:center }
    .btn {
      padding:8px 12px;
      border-radius:8px;
      border:1px solid var(--glass);
      background:transparent;
      
      font-weight:600;
      font-size:13px;
    }
    .btn.primary {
      background: linear-gradient(90deg,var(--cta), var(--accent));
      border:0;
      box-shadow: 0 8px 24px rgba(67,56,202,0.12);
    }

    /* Main */
    main{
      padding:48px 64px;
      max-width:1200px;
      margin:0 auto;
    }
    .hero{
      margin-bottom:36px;
    }
    .hero h1{
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      font-size:48px;
      margin:0 0 8px 0;
    }
    .hero p{ color:var(--muted); margin:0 0 18px 0; font-size:16px }

    /* Projects */
    .projects {
      display:grid;
      grid-template-columns:repeat(3, 1fr);
      gap:18px;
    }
    .project {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.088), rgba(0, 0, 0, 0.01));
      border-radius:12px;
      padding:18px;
      border:1px solid var(--glass);
      min-height:110px;
    }
    .project h3{ margin:0 0 8px 0; font-size:18px }
    .project p{ margin:0; color:var(--muted); font-size:14px }

    /* Empty state centered */
    .empty {
      text-align:center;
      padding:56px 20px;
      border-radius:12px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.02));
      border:1px solid var(--glass);
      color:var(--muted);
    }
    a:visited{
      color: #ffffff;
      text-decoration: none;
    }
    a{
      color: #ffffff;
      text-decoration: none;
    }
    .action-btns{
      position: relative;
      float: right;
    }

    @media (max-width:900px){
      .projects{ grid-template-columns:repeat(2,1fr); }
      main{ padding:32px 28px; }
      .hero h1{ font-size:36px; }
    }
    @media (max-width:600px){
      .projects{ grid-template-columns: 1fr; }
      header{ padding:12px 16px }
      main{ padding:20px 16px }
    }
  </style>
</head>
<body>
  <header>
    <div class="logo"><a href="/">TeamTask</a></div>
    <div class="nav-actions">
      <a href="/logout" class="btn">Logout</a>
      <a href="/notes/create" class="btn primary">New Note</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <h1>Welcome <%= userName%>!</h1>
      <h1>Your Notes:</h1>
      <p>All your notes and their quick summaries. Click a project to open details and tasks.</p>
    </section>

    <section>
      <div class="projects">
      </div>
    </section>

    <!-- optional empty state (uncomment / replace above projects if no projects) -->
    <!--
    <section>
      
    </section>
    -->
  </main>
  <script>
        const projectContainer = document.querySelector('.projects')

        //fetching user projects  
        //check what if the res contains empty response
        async function fetchUserProjects(){
          try{
            const res = await fetch('/notes');
            const data = await res.json();
            const notes = data.notes
            // console.log(notes)
            // const data = notes.notes.json()
            let html = ''
            if(!notes.length){
              html = `<div class="empty">
        <strong>No projects yet</strong>
        <p>Create your first project to organize tasks and collaborate with your team.</p>
      </div>`
            projectContainer.innerHTML = html
            }
            const generateHtml = (notes) => {
            notes.forEach(note => {
              console.log(note._id)
            html+= `
              <div class="project">
                <div class="action-btns">
                  <a href="/notes" class="btn">✏️</a>
                  <button type="button" onclick='
                  var result = confirm("Want to delete?");
if (result) {
    deleteNote(${JSON.stringify(note._id)})
}
                  
                  '>🗑️</button>
                </div>
              <h3>${note.title}</h3>
              <p>${note.summary}</p>
               </div>`
            })
        } 
            await generateHtml(notes)
            projectContainer.innerHTML = html
        }catch(e){
          console.log(e)
          alert('fetching projects failed')
        }

        }
        fetchUserProjects()

        //todo-use dataset attributes to assign notes id to each container and when you click on
        //the cards, it sends request to server to open a separate ejs view in new page and then add update functionality to it

        const deleteNote = async(id) => {
          console.log(id)
          try{
            const res = await fetch(`/notes/delete/${encodeURIComponent(id)}`, { method: 'DELETE' })
            if(!res.ok){
              alert('Failed to delete note')
            }
          } catch(e){
            console.log(e)
          }
          fetchUserProjects()
        }




        
        
        
        
        
  </script>
</body>
</html>
