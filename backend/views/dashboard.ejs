<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TeamTask — Notes</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Poppins:wght@600;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b0b0c;
      --panel:#0f0f11;
      --muted:#9CA3AF;
      --white:#ffffff;
      --accent:#6c4bd6;
      --cta:#3b82f6;
      --glass: rgba(255,255,255,0.03);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter,system-ui,Arial;
      background:linear-gradient(180deg,var(--bg), #0f0f11);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      min-height:100vh;
    }

    /* Nav */
    header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 40px;
      border-bottom:1px solid rgba(255,255,255,0.03);
      background: rgba(255,255,255,0.01);
    }
    .logo {
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      font-size:20px;
      letter-spacing:-0.02em;
    }
    .nav-actions { display:flex; gap:10px; align-items:center }
    .edit-btn {
      padding:8px 10px;
      border-radius:8px;
      border:1px solid var(--glass);
      background:transparent;
      
      font-weight:600;
      font-size:10px;
      transition: all .3s ;
    }
    .btn
      {
      padding:8px 12px;
      border-radius:8px;
      border:1px solid var(--glass);
      background:transparent;
      
      font-weight:600;
      font-size:13px;
      transition: all .3s ;
    }
    
    .edit-btn:hover{
        background: #9CA3AF;
    }
    .btn.primary {
      background: linear-gradient(90deg,var(--cta), var(--accent));
      border:0;
      box-shadow: 0 8px 24px rgba(67,56,202,0.12);
    }

    /* Main */
    main{
      padding:48px 64px;
      max-width:1200px;
      margin:0 auto;
    }
    .hero{
      margin-bottom:36px;
    }
    .hero h1{
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      font-size:40px;
      margin:0 0 8px 0;
    }
    .hero p{ color:var(--muted); margin:0 0 18px 0; font-size:16px }

    /* Projects */
    .projects {
      display:grid;
      grid-template-columns:repeat(5, 1fr);
      gap:18px;
    }
    .project {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.088), rgba(0, 0, 0, 0.01));
      border-radius:12px;
      padding:18px;
      border:1px solid var(--glass);
      min-height:110px;
      transition: all .3s;
      cursor: pointer;
      max-height:150px;
      max-width: 280px;
      overflow: ellipsis;
    }
    .project:hover{
      transform: scale(105%);
    }
    .project h3{ margin:0 0 8px 0; font-size:18px }
    .project p{ margin:0; color:var(--muted); font-size:14px }

    /* Empty state centered */
    .empty {
      text-align:center;
      padding:30px 20px;
      border-radius:12px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.02));
      border:1px solid var(--glass);
      color:var(--muted);
      max-height:150px;
    }
    a:visited{
      color: #ffffff;
      text-decoration: none;
    }
    a{
      color: #ffffff;
      text-decoration: none;
    }
    .action-btns{
      position: relative;
      float: right;
    }

    .projects{
      min-height: 300px;
    }
    button:hover{
      cursor: pointer;
    }
    @media (max-width:900px){
      .projects{ grid-template-columns:repeat(2,1fr); }
      main{ padding:32px 28px; }
      .hero h1{ font-size:36px; }
    }
    @media (max-width:600px){
      .projects{ grid-template-columns: 1fr; }
      header{ padding:12px 16px }
      main{ padding:20px 16px }
    }
    h3{
      white-space: nowrap; 
      overflow: hidden;  
      text-overflow: ellipsis;
    }
    .summary{
      white-space: nowrap; 
      overflow: hidden;  
      text-overflow: ellipsis;
    }
  </style>
</head>
<body>
  <header>
    <div class="logo"><a href="/dashboard">TeamTask</a></div>
    <div class="nav-actions">
      <a href="/logout" class="btn">Logout</a>
      <a href="/notes/create" class="btn primary">New Note</a>
      <a href="/collaborations/create" class="btn primary">New Collaborative Note</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <h1>Welcome <%= userName%>!</h1>
      <h1>Your Notes:</h1>
      <p>All your notes and their quick summaries. Click a project to open details and tasks.</p>
    </section>

    <section>
      <div class="projects">
      </div>
    </section>

    <section class="hero collaborate-hero">
      <h1>Your Collaborative Notes:</h1>
      <p>All your notes and their quick summaries. Click a project to open details and tasks.</p>
    </section>


    <section>
      <div class=" Collaborative-projects">
         <p>Your Collaborative Notes:</p>
        <div class="notesOwner projects">
        </div>
        <p>Your Collaborations:</p>
        <div class="notesCollaborator projects">
        </div>
      </div>
    </section>

  </main>
  <script>
        const projectContainer = document.querySelector('.projects')
        const collaborativProjectContainer = document.querySelector('.Collaborative-projects')

        const notesOwnerContainer = document.querySelector('.notesOwner')
        const notesCollaboratorContainer = document.querySelector('.notesCollaborator')
        //fetching user projects  
        //check what if the res contains empty response
        async function fetchUserProjects(){
          try{
            const res = await fetch('/notes');
            const data = await res.json();
            const notes = data.notes
            // console.log(notes)
            // const data = notes.notes.json()
            let html = ''
            if(!notes.length){
              html = `<div class="empty">
        <strong>No Notes Yet</strong>
        <p>Create your first note to organize tasks and collaborate with your team.</p>
      </div>`
            projectContainer.innerHTML = html
            }
            const generateHtml = (notes) => {
            notes.forEach(note => {
            html+= `
              <div class="project">
                <div class="action-btns">
                  <button onclick='
                  let result = confirm("Want to delete this note?");
                  if (result) {
                      deleteNote(${JSON.stringify(note._id)})
                  }                  
                  '>🗑️</button>
                </div>
                <div onclick="window.location.href='/notes/${note._id}'">
              <h3>${note.title}</h3>
              <p class="summary">${note.summary}</p>
              </div>
               </div>`
            })
        } 
            await generateHtml(notes)
            projectContainer.innerHTML = html
        }catch(e){
          console.log(e)
          alert('fetching projects failed')
        }
      }



      //fetching the collaborative notes
      //this returns two objects, one with notes where the user is owner, and there will be delete button with it.
      //and one where the user is the collaborator, it will not have the delete note button.


      async function fetchCollaborativeProjects(){
          try{
            const res = await fetch('/collaborations');
            const data = await res.json();
            const notesOwner = data.notesFoundOwner
            const notesCollaborator = data.notesFoundCollaborator
            let notesOwnerHtml = ''
            let notesCollaboratorHtml = ''

            if(!notesOwner.length){
              notesOwnerHtml = `<div class="empty">
        <strong>No Collaborative Notes Yet</strong>
        <p>Create your first collaborative note to organize tasks and collaborate with your team.</p>
      </div>`
            notesOwnerContainer.innerHTML = notesOwnerHtml
            }

            if(!notesCollaborator.length){
              notesCollaboratorHtml = 
          `<div class="empty">
        <strong>Not In Any Collaborations Yet</strong>
        <p>Be added to someone's note as a collaborator to organize tasks and collaborate with your team.</p>
      </div>`







            notesCollaboratorContainer.innerHTML = notesCollaboratorHtml
            }


            const generateNoteOwnerHtml = (notes) => {
            notes.forEach(note => {
            notesOwnerHtml+= `
              <div class="project">
                <div class="action-btns">
                  <button type="button" onclick='
                  let result = confirm("Want to delete this note?");
                  if (result) {
                      deleteCollaborativeNote(${JSON.stringify(note._id)})
                  }                  
                  '>🗑️</button>
                </div>
                <div onclick="window.location.href='/collaborations/${note._id}'">
              <h3>${note.title}</h3>
              <p class="summary">${note.summary}</p>
              </div>
               </div>`
            })
        } 

            const generateNoteCollaboratorHtml = (notes) => {
            notes.forEach(note => {

            notesCollaboratorHtml+= `
              <div class="project" onclick="window.location.href='/collaborations/${note._id}'">
              <h3>${note.title}</h3>
              <p class="summary">${note.summary}</p>
              <p class="owner">Owner: ${note.ownerUsername}</p>
               </div>`
            })
        } 


            await generateNoteOwnerHtml(notesOwner)
            await generateNoteCollaboratorHtml(notesCollaborator)

            notesOwnerContainer.innerHTML = notesOwnerHtml
            notesCollaboratorContainer.innerHTML = notesCollaboratorHtml
        }catch(e){
          console.log(e)
          alert('fetching projects failed', e)
        }
        }












        
        fetchUserProjects()
        fetchCollaborativeProjects()

        //todo-use dataset attributes to assign notes id to each container and when you click on
        //the cards, it sends request to server to open a separate ejs view in new page and then add update functionality to it

        const deleteNote = async(id) => {

          try{
            const res = await fetch(`/notes/delete/${encodeURIComponent(id)}`, { method: 'DELETE' })
            if(!res.ok){
              alert('Failed to delete note')
            }
          } catch(e){
            console.log(e)
          }
          fetchUserProjects()
        }



        //i can impirove this by changing the url instead of making a whole another function
        const deleteCollaborativeNote = async(id) => {

          try{
            const res = await fetch(`/collaborations/${encodeURIComponent(id)}/delete`, { method: 'DELETE' })
            if(!res.ok){
              alert('Failed to delete note')
            }
          } catch(e){
            console.log(e)
          }
          fetchCollaborativeProjects()
        }

          const fetchCollaborativeProjectsPolling  = async()=> {
          
          try{
            const res = await fetch('/collaborations');
            const data = await res.json();
            const notes = data.notesFoundCollaborator
            let notesCollaboratorHtml = ''

            notes.forEach(note => {
            notesCollaboratorHtml+= `
              <div class="project" onclick="window.location.href='/collaborations/${note._id}'">
              <h3>${note.title}</h3>
              <p class="summary">${note.summary}</p>
              <p class="owner">Owner: ${note.ownerUsername}</p>
               </div>`
            })

            notesCollaboratorContainer.innerHTML = notesCollaboratorHtml
          }catch(e){
            console.log(e)
          }

         }


         setInterval(() => {
          fetchCollaborativeProjectsPolling()
          console.log('polled')
         }, 15000)
  </script>
</body>
</html>
