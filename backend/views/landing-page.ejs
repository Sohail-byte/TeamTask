<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TeamTask — Landing</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Poppins:wght@600;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg-900: #0b0b0c;
      --bg-800: #101014;
      --panel: rgba(255,255,255,0.02);
      --muted: #9aa3ad;
      --white: #ffffff;
      --accent-purple: #ffffff; /* headline accent */
      --accent-blue: #ffffff; /* CTA / icon */
      --cta-grad: linear-gradient(90deg,#3b82f6 0%, #8b5cf6 100%);
      --glass-border: rgba(255,255,255,0.05);
      --card-shadow: 0 10px 30px rgba(10,10,12,0.5);
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: linear-gradient(180deg,var(--bg-900) 0%, #0f0f11 100%);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
    }

    /* Navigation */
    .nav {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:20px 48px;
      background-color: var(--bg-800);
      border-bottom: 1px solid rgba(255,255,255,0.03);
      position:sticky;
      top:0;
      z-index:50;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:14px;
    }
    .logo{
      font-family: "Poppins", sans-serif;
      font-weight:800;
      letter-spacing: -0.02em;
      font-size:30px;
      color:var(--white);
    }
    .nav-actions {
      display:flex;
      align-items:center;
      gap:12px;
    }
    .btn {
      padding:10px 16px;
      border-radius:8px;
      font-weight:600;
      font-size:14px;
      border:1px solid var(--glass-border);
      background:transparent;
      color:var(--white);
      cursor:pointer;
    }
    /* HERO */
    .hero {
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:78vh;
      padding: 48px;
    }
    .hero-inner {
      max-width:1100px;
      width:100%;
      padding: 48px 64px;
      display:block;
    }
    .eyebrow{ display:block; color:var(--muted); margin-bottom:10px; font-weight:600; font-size:14px; letter-spacing:0.02em; }
    h1{
      font-family:"Poppins",system-ui;
      font-weight:800;
      font-size: clamp(40px, 6.8vw, 96px);
      line-height:0.98;
      margin:0 0 20px 0;
      color:var(--white);
      text-wrap:balance;
    }
    .lead {
      color:var(--muted);
      font-size:18px;
      line-height:1.6;
      max-width:820px;
      margin-bottom:28px;
      font-weight:400;
    }
    .cta {
      display:inline-block;
      padding:10px 18px;
      border-radius:12px;
      font-weight:700;
      font-size:16px;
      text-decoration:none;
      color:white;
      box-shadow: 0 8px 30px rgba(67,56,202,0.15);
      border: 1px solid var(--white);
    }

    /* Features row */
    .features-outer{
      padding:64px 48px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0));
    }
    .features {
      max-width:1200px;
      margin:0 auto;
      text-align:center;
    }
    .features h2 {
      color: var(--accent-purple);
      font-size:36px;
      margin:0 0 28px 0;
      font-weight:700;
      font-family:"Poppins",sans-serif;
    }

    .cards {
      display:grid;
      grid-template-columns: repeat(4,1fr);
      gap:20px;
      margin-top:18px;
    }
    .card {
      background: linear-gradient(180deg, rgba(255,255,255,0.015), rgba(0,0,0,0.02));
      border-radius:12px;
      padding:26px;
      text-align:left;
      border:1px solid var(--glass-border);
      box-shadow: var(--card-shadow);
      min-height:160px;
    }
    .icon {
      width:48px; height:48px; display:inline-flex; align-items:center; justify-content:center; border-radius:8px;
      background: rgba(59,130,246,0.05);
      margin-bottom:12px;
    }
    .card h3{ margin:6px 0 8px 0; font-size:18px; color:var(--white); font-weight:600;}
    .card p{ margin:0; color:var(--muted); font-size:14px; line-height:1.45; }

    /* Secondary section */
    .section-cta {
      padding:80px 48px;
      background: linear-gradient(180deg, rgba(108,75,214,0.06), rgba(0,0,0,0));
      text-align:center;
    }
    .section-cta h3{
      margin:0;
      font-family:"Poppins";
      font-size:36px;
      color:white;
      font-weight:700;
    }
    .section-cta p{
      color:var(--muted);
      max-width:900px;
      margin:18px auto 0 auto;
      font-size:18px;
      line-height:1.6;
    }

    /* How it works row */
    .how { padding:64px 48px; }
    .how .cards { grid-template-columns: repeat(3,1fr); }

    footer {
      padding:28px 48px;
      border-top:1px solid white /* rgba(255,255,255,0.02)*/;
      text-align:center;
      color:var(--muted);
      font-size:14px;
      background: linear-gradient(180deg, rgba(0,0,0,0.03), rgba(0,0,0,0.07));
    }

    /* Responsive */
    @media (max-width:1100px){
      .cards{ grid-template-columns: repeat(2,1fr); }
      .nav{ padding:14px 24px; }
      .hero-inner{ padding:36px 28px; }
    }
    @media (max-width:700px){
      .cards{ grid-template-columns: 1fr; }
      h1{ font-size: clamp(28px, 8vw, 48px); text-align:center; }
      .hero-inner{ padding:24px 18px; text-align:center; }
      .lead{ text-align:center; }
      .nav-actions{ gap:8px; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <header class="nav" role="banner">
    <div class="brand">
      <div class="logo">TeamTask</div>
    </div>

    <div class="nav-actions" role="navigation" aria-label="Main">
      <a class="cta" href="/signup">Get Started</a>
    </div>
  </header>

  <!-- HERO -->
  <main>
    <section class="hero" aria-label="Hero">
      <div class="hero-inner">
        <span class="eyebrow">Collaborative tasks & notes</span>
        <h1>Team up. <br/> Organize. Achieve.</h1>
        <p class="lead">The simplest way to manage tasks and notes together. TeamTask helps small teams and individuals track work, share lists, and finish more.</p>
        
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features-outer">
      <div class="features">
        <h2>Why Choose TeamTask?</h2>

        <div class="cards" role="list">
          <div class="card" role="listitem">
            <div class="icon" aria-hidden="true">
              <!-- simple check-square icon -->
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h3>Task Management</h3>
            <p>Easily manage all your tasks with an intuitive, shareable interface for teams and solo users.</p>
          </div>

          <div class="card" role="listitem">
            <div class="icon" aria-hidden="true">
              <!-- note icon -->
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15V6a2 2 0 0 0-2-2H8l-5 5v8a2 2 0 0 0 2 2h10"/><path d="M17 21v-6"/></svg>
            </div>
            <h3>Notes App</h3>
            <p>Capture and organize notes alongside your tasks so nothing slips through the cracks.</p>
          </div>

          <div class="card" role="listitem">
            <div class="icon" aria-hidden="true">
              <!-- eye icon -->
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3>Full Visibility</h3>
            <p>Track progress with clear overviews and timeline history for every project.</p>
          </div>

          <div class="card" role="listitem">
            <div class="icon" aria-hidden="true">
              <!-- check circle -->
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>
            </div>
            <h3>Complete Tasks</h3>
            <p>Mark items done, sync across devices, and keep a clean, prioritized to-do list.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SIMPLE CTA section -->
    <section class="section-cta" aria-label="About">
      <h3>A simple way to stay organized</h3>
      <p>TeamTask helps you manage your to-do list and notes effortlessly so you can focus on what matters. Invite teammates, assign tasks, and keep everything in one place.</p>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how" aria-label="How it works">
      <div class="features" style="max-width:1100px;">
        <h2 style="color:var(--accent-purple);">How It Works</h2>
        <div class="cards" style="margin-top:20px;">
          <div class="card">
            <div class="icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6"/><path d="M6 10h12"/></svg></div>
            <h3>Create an Account</h3>
            <p>Sign up, set up your team and projects — get started in minutes.</p>
          </div>

          <div class="card">
            <div class="icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11h18"/><path d="M6 7v8"/></svg></div>
            <h3>Generate Tasks & Notes</h3>
            <p>Create tasks, add notes, set due dates and priorities with a clean editor.</p>
          </div>

          <div class="card">
            <div class="icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20v-6"/><path d="M8 12l1-1 3 3 5-5 1 1"/></svg></div>
            <h3>Monitor & Manage</h3>
            <p>Assign people, follow status, and close tasks when done. Sync across devices.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer>
    © 2024 TeamTask. All rights reserved.
  </footer>

</body>
</html>
