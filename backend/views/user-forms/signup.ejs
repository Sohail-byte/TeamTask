<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TeamTask — Landing</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Poppins:wght@600;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg-900: #0b0b0c;
      --bg-800: #101014;
      --panel: rgba(255,255,255,0.02);
      --muted: #9aa3ad;
      --white: #ffffff;
      --accent-purple: #ffffff; /* headline accent */
      --accent-blue: #ffffff; /* CTA / icon */
      --cta-grad: linear-gradient(90deg,#3b82f6 0%, #8b5cf6 100%);
      --glass-border: rgba(255,255,255,0.05);
      --card-shadow: 0 10px 30px rgba(10,10,12,0.5);
    }

    *{box-sizing:border-box
    }
    html,body{height:100%}
    body{
      margin:0;
      font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: linear-gradient(180deg,var(--bg-900) 0%, #0f0f11 100%);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      overflow: hidden;
    }
    section{
      display: flex;
      align-items: center;
      justify-content: center;
      height: 80%;
    }
    /* Navigation */
    .nav {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:20px 48px;
      background-color: var(--bg-800);
      border-bottom: 1px solid rgba(255,255,255,0.03);
      position:sticky;
      top:0;
      z-index:50;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:14px;
    }
    .logo{
      font-family: "Poppins", sans-serif;
      font-weight:800;
      letter-spacing: -0.02em;
      font-size:30px;
      color:var(--white);
    }
    .nav-actions {
      display:flex;
      align-items:center;
      gap:12px;
    }
    .btn {
      padding:10px 16px;
      border-radius:8px;
      font-weight:600;
      font-size:14px;
      border:1px solid var(--glass-border);
      background:transparent;
      color:var(--white);
      cursor:pointer;
    }
    .form-container{
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      height: 400px;
      width: 50%;
      background-color: var(--bg-800);
    }
    form{
      width: 80%;
      padding: 20px;
      display: flex;
      flex-direction: column;
      row-gap: 10px;
    }
    input{
      width: 100%;
      height: 40px;
      padding: 0px 10px 0px 10px;
      background-color: var(--bg-800);
      color: #ffffff;
      border-radius: 8px;
      border: 1px solid white;
      font-size: 15px;
      font-family: "Poppins", sans-serif;
      font-weight:300;
      letter-spacing: -0.02em;
      color:var(--white);
    }
    .submit-btn{
      border: 1px solid white;
      transition: all .3s;
    }
    .submit-btn:hover{
      background: rgba(255, 255, 255, 0.71);
      color: var(--bg-800);
    }
    h1{
      font-family: "Poppins", sans-serif;
      font-weight:500;
      letter-spacing: -0.02em;
      font-size:30px;
      color:var(--white);
      margin-top: -30px;
    }

    /* Responsive */
    @media (max-width:1100px){

      .nav{ padding:14px 24px; }

    }
    @media (max-width:700px){
      .nav-actions{ gap:8px; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <header class="nav" role="banner">
    <div class="brand">
      <div class="logo">TeamTask</div>
    </div>
  </header>

  <!-- HERO -->
    <section class="reg-form">
      <div class="form-container">
        <h1>Signup</h1>
        <form action="/users/signup" method="POST">
          <input autocomplete="off" type="text" name="userName" placeholder="Username" required /><br/>
          <input autocomplete="off" type="email" name="email" placeholder="Email" required /><br/>
          <input autocomplete="off" type="password" name="password" placeholder="Password" required /><br/>
          <button type="submit" class="btn submit-btn">Register</button>
           <% if (error) { %>
    <div style="color: red;"><%= error %></div>
  <% } %>
        </form>
      </div>
    </section>
</body>
</html>
