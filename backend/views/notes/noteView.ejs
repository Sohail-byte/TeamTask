<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Poppins:wght@600;800&display=swap" rel="stylesheet">
  <title>TeamTask - View Note</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    :root{
      --bg:#0b0b0c;
      --panel:#0f0f11;
      --muted:#9CA3AF;
      --white:#ffffff;
      --accent:#6c4bd6;
      --cta:#3b82f6;
      --glass: rgba(255,255,255,0.03);
      --bg:#0b0b0c;
      --panel:#0f0f11;
      --muted:#9CA3AF;
      --white:#ffffff;
      --accent:#6c4bd6;
      --cta:#3b82f6;
      --glass: rgba(255,255,255,0.03);
    }
    
    *{box-sizing:border-box}
    

body{
      margin:0;
      font-family:Inter,system-ui,Arial;
      background:linear-gradient(180deg,var(--bg), #0f0f11);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      min-height:100vh;
      width: 100%;
    }
    a:visited{
      color: #ffffff;
      text-decoration: none;
    }
    a{
      color: #ffffff;
      text-decoration: none;
    }

    /* Nav */
    header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 40px;
      border-bottom:1px solid rgba(255,255,255,0.03);
      background: rgba(255,255,255,0.01);
    }
    .logo {
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      font-size:20px;
      letter-spacing:-0.02em;
    }
    .nav-actions { display:flex; gap:10px; align-items:center }
    .btn {
      padding:8px 12px;
      border-radius:8px;
      border:1px solid var(--glass);
      background:transparent;
      color:var(--white);
      font-weight:600;
      font-size:13px;
    }
    .btn.primary {
      background: linear-gradient(90deg,var(--cta), var(--accent));
      border:0;
      box-shadow: 0 8px 24px rgba(67,56,202,0.12);
    }
    .editor-container {
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.02));
      border-radius: 16px;
      padding: 40px;
      border: 1px solid var(--glass);
      width: 100%;
      max-width: 1200px;
    }

    h1 {
      font-size: 28px;
      margin: 0 0 32px 0;
      text-align: center;
      color: var(--white);
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      letter-spacing:-0.02em;
    }

    .form-group {
      margin-bottom: 24px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      font-size: 14px;
      color: var(--muted);
    }

    input[type="text"], textarea {
      width: 100%;
      padding: 16px;
      border-radius: 8px;
      border: 1px solid var(--glass);
      background: rgba(255,255,255,0.02);
      color: var(--white);
      font-size: 16px;
      font-family: Inter, sans-serif;
      transition: all 0.2s ease;
    }
    pre{
      background: rgba(255,255,255,0.02);
        padding: 16px;
        border-radius: 8px;
        border: 1px solid var(--glass);   
    }
    input[type="text"]:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(108, 75, 214, 0.2);
    }

    textarea {
      min-height: 200px;
      resize: vertical;
      line-height: 1.5;
    }

    .submit-btn {
      width: 30%;
      padding: 16px;
      border: none;
      border-radius: 8px;
      background: linear-gradient(90deg, var(--cta), var(--accent));
      color: var(--white);
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
  display: block;
  margin: 0 auto;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(67,56,202,0.3);
    }

    .submit-btn:active {
      transform: translateY(0);
    }
       header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 40px;
      border-bottom:1px solid rgba(255,255,255,0.03);
      background: rgba(255,255,255,0.01);
    }
    main{
        width: 100%;
        display: grid;
        place-items: center;
        margin-top: 5rem;
    }
    pre{
      font-family:Poppins, Inter, sans-serif;
      text-wrap: auto;
    }
    .edit-btn:hover{
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(67,56,202,0.3);
    }
    .edit-btn:active{
      transform: translateY(0);
    }
    .note-bar{
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    }
    .note-bar .edit-btn{
      grid-column: 3;
    justify-self: end;
    }
    .editor-container{
      display: flex;
      flex-direction: column;
    }
    .note-bar h1{
      grid-column: 2;
    justify-self: center;
    margin: 0;
    }
    .invis{
      display: none;
    }
    @media (max-width: 600px) {
      .editor-container {
        padding: 24px;
      }
      h1 {
        font-size: 24px;
        header{ padding:12px 16px }
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="nav-actions">
    <div class="logo"><a href="/dashboard">TeamTask</a></div>
    </div>
  </header>
<body>
    <main>
  <div class="editor-container">
    <div class="note-bar"><h1>View Note</h1> <button class="btn edit-btn">Edit</button></div>
    

        <label for="noteTitle">Title</label>
        <pre class="noteTitle text-view" name="noteTitle"><%= note.title %></pre>
  
        <label for="noteSummary">Summary</label>
        <pre class="noteSummary text-view" name="noteSummary"><%= note.summary %></pre>

        <label for="noteContent">Content</label>
          <pre class="noteContent text-view" name="noteContent"><%= note.content %></pre>
          <button class="submit-btn invis">Update</button>
  </div>
</main>
  <script>
    const editBtn = document.querySelector('.edit-btn')
    const submitBtn = document.querySelector('.submit-btn')
    editBtn.addEventListener('click', () => {
      if(editBtn.textContent==='Edit'){
      document.querySelectorAll('pre').forEach(pre => {
        pre.setAttribute('contenteditable', 'true')
      })
      submitBtn.classList.remove('invis')
      editBtn.textContent = "Cancel"
      }else{
      location.reload()
      }
    })

      submitBtn.addEventListener('click', async () => {
          const title = document.querySelector('.noteTitle').textContent
          const summary = document.querySelector('.noteSummary').textContent
          const content = document.querySelector('.noteContent').textContent

          try{
          const res = await fetch(`/notes/<%= note._id %>/update`, {
            method: "PUT",
            headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
            body: JSON.stringify({title, summary, content})
          })
            if(!res.ok){
              alert('Failed to update note')
            }else{
              location.reload()
            }
          }catch(e){
            console.log(e)
          }
          
      } )


  </script>
</body>
</html>

