<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Poppins:wght@600;800&display=swap" rel="stylesheet">
  <title>TeamTask - View Note</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    :root{
      --bg:#0b0b0c;
      --panel:#0f0f11;
      --muted:#9CA3AF;
      --white:#ffffff;
      --accent:#6c4bd6;
      --cta:#3b82f6;
      --glass: rgba(255,255,255,0.03);
      --bg:#0b0b0c;
      --panel:#0f0f11;
      --muted:#9CA3AF;
      --white:#ffffff;
      --accent:#6c4bd6;
      --cta:#3b82f6;
      --glass: rgba(255,255,255,0.03);
    }
    
    *{box-sizing:border-box}
    

body{
      margin:0;
      font-family:Inter,system-ui,Arial;
      background:linear-gradient(180deg,var(--bg), #0f0f11);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      min-height:100vh;
      width: 100%;
    }
    a:visited{
      color: #ffffff;
      text-decoration: none;
    }
    a{
      color: #ffffff;
      text-decoration: none;
    }

    /* Nav */
    header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 40px;
      border-bottom:1px solid rgba(255,255,255,0.03);
      background: rgba(255,255,255,0.01);
    }
    .logo {
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      font-size:20px;
      letter-spacing:-0.02em;
    }
    .nav-actions { display:flex; gap:10px; align-items:center }
    .btn {
      padding:8px 12px;
      border-radius:8px;
      border:1px solid var(--glass);
      background:transparent;
      color:var(--white);
      font-weight:600;
      font-size:13px;
    }
    .btn.primary {
      background: linear-gradient(90deg,var(--cta), var(--accent));
      border:0;
      box-shadow: 0 8px 24px rgba(67,56,202,0.12);
    }
    .editor-container {
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.02));
      border-radius: 16px;
      padding: 40px;
      border: 1px solid var(--glass);
      width: 100%;
      max-width: 1200px;
      grid-row: span 5 / span 5;
    }

    h1 {
      font-size: 28px;
      margin: 0 0 32px 0;
      text-align: center;
      color: var(--white);
      font-family:Poppins, Inter, sans-serif;
      font-weight:800;
      letter-spacing:-0.02em;
    }

    .form-group {
      margin-bottom: 24px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      font-size: 14px;
      color: var(--muted);
    }

    input[type="text"], textarea {
      
      padding: 16px;
      border-radius: 8px;
      border: 1px solid var(--glass);
      background: rgba(255,255,255,0.02);
      color: var(--white);
      font-size: 16px;
      font-family: Inter, sans-serif;
      transition: all 0.2s ease;
    }
    pre{
      background: rgba(255,255,255,0.02);
        padding: 16px;
        border-radius: 8px;
        border: 1px solid var(--glass);   
    }
    input[type="text"]:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(108, 75, 214, 0.2);
    }

    textarea {
      min-height: 200px;
      resize: vertical;
      line-height: 1.5;
    }

    .submit-btn {
      width: 30%;
      padding: 16px;
      border: none;
      border-radius: 8px;
      background: linear-gradient(90deg, var(--cta), var(--accent));
      color: var(--white);
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
  display: block;
  margin: 0 auto;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(67,56,202,0.3);
    }

    .submit-btn:active {
      transform: translateY(0);
    }
       header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 40px;
      border-bottom:1px solid rgba(255,255,255,0.03);
      background: rgba(255,255,255,0.01);
    }
    main{
        width: 100%;
        padding: 25px;
        margin-top: 5rem;
        display: grid; 
  grid-template-columns: 20% 60% 20%; 
  grid-template-rows: 1fr 1fr 1fr; 
  gap: 0px 0px; 
  grid-template-areas: 
    "col1 col2 col3"
    "col1 col2 col3"
    "col1 col2 col3"; 
    }
    pre{
      font-family:Poppins, Inter, sans-serif;
      text-wrap: auto;
    }
    .edit-btn:hover{
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(67,56,202,0.3);
    }
    .edit-btn:active{
      transform: translateY(0);
    }
    .note-bar{
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    }
    .note-bar .edit-btn{
      grid-column: 3;
    justify-self: end;
    }
    .editor-container{
      display: flex;
      flex-direction: column;
      grid-area: col2;
      
    }
    .note-bar h1{
      grid-column: 2;
    justify-self: center;
    margin: 0;
    }
    .invis{
      display: none;
    }


    .collaborators{
      border: 1px solid var(--glass);
      width: 350px;
      min-height: 200px;
      max-height: 400px;
      padding: 16px;
      border-radius: 8px;
      grid-area: col1;
      background-color: var(--panel);
    }

    .collaboratorUsername{
      width: 100%;
    }
    .addBtn{
      padding: 16px;
      border: none;
      border-radius: 8px;
      background: linear-gradient(90deg, var(--cta), var(--accent));
      color: var(--white);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
  display: block;
  width: 50%;
    }

    .addBtn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(67,56,202,0.3);
    }


    .input-row{
      display: flex;
      gap: 5%;
      margin-top: 10px;
    }
    select{
      width: 50%;
      background-color: var(--panel);
      color: var(--white);
      border-radius: 8px;
      font-size: 14px;
      border: 1px solid var(--glass);
    }
    .collaborator{
      display: flex;
      justify-content: space-between;
      background: rgba(255,255,255,0.02);
      border-radius: 8px;
      padding-left: 5px;
    }
.collaborator-list{
  padding: 5px;
  margin-top: 10px;
  max-height: 160px;
  overflow: scroll;
}
.collaborator{
  margin: 5px;
}
.remove-btn{
  border-radius: 8px;
  border: none;
  background-color: red;
  color: white;
}
    @media (max-width: 600px) {
      .editor-container {
        padding: 24px;
      }
      h1 {
        font-size: 24px;
        header{ padding:12px 16px }
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="nav-actions">
    <div class="logo"><a href="/dashboard">TeamTask</a></div>
    </div>
  </header>
<body>
    <main>
  <div class="editor-container">
    <div class="note-bar"><h1>Collaborative Note</h1> <button class="btn edit-btn">Edit</button></div>
    

        <label for="noteTitle">Title</label>
        <pre class="noteTitle text-view" name="noteTitle"><%= note.title %></pre>
  
        <label for="noteSummary">Summary</label>
        <pre class="noteSummary text-view" name="noteSummary"><%= note.summary %></pre>

        <label for="noteContent">Content</label>
          <pre class="noteContent text-view" name="noteContent"><%= note.content %></pre>
          <button class="submit-btn invis">Update</button>
  </div>
<!-- adding the collaborators panel. -->
  <div class="collaborators">
    <div class="inner-container">
        <h1 class="collab-heading">Collaborators</h1>
        <div class="collab-input">
          <input type="text" name="collaboratorUsername" class="collaboratorUsername" placeholder="Enter username..." required>
          <div class="input-row">
            <select name="permission" class="permission">
              <option value="">Permission</option>
              <option value="view">View</option>
              <option value="edit">View/Edit</option>
            </select>
            <button class="addBtn" onclick="addCollaborator()">Add</button>
          </div>
        </div>
        <div class="collaborator-list">
        </div>
    </div>
  </div>
 </div>
</main>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
<script type="module">
  import lodash from "https://cdn.jsdelivr.net/npm/lodash@4.17.21/+esm"
  //logic for sockets
        const socket = io()
        socket.on('connected', (msg) => {
          console.log(msg)
        })
        //joining a room with the notes id as the room id
        socket.emit('join-room', "<%= note.id %>")
        socket.on('joined-room', (roomId) => {
          console.log(roomId)
        })


        const handleTitleChange = async(content) =>{
            socket.emit('noteTitleInput', JSON.stringify(content))
        }
        const handleSummaryChange = async(content) =>{
            socket.emit('noteSummaryInput', JSON.stringify(content))
        }
        const handleContentChange = async(content) =>{
            socket.emit('noteContentInput', JSON.stringify(content))
        }

        const titlePre = document.querySelector('.noteTitle')
        const summaryPre = document.querySelector('.noteSummary')
        const contentPre = document.querySelector('.noteContent')


        //making the debounced functions
        const debouncedTitleChange = lodash.debounce(handleTitleChange, 400)
        const debouncedSummaryChange = lodash.debounce(handleSummaryChange, 400)
        const debouncedContentChange = lodash.debounce(handleContentChange, 500)




        //adding event listeners to the PRE elements instead of using oninput for debouncing
        titlePre.addEventListener('input', (e) => {
            debouncedTitleChange(e.target.textContent)
          })
        
        summaryPre.addEventListener('input', (e) => {
            debouncedSummaryChange(e.target.textContent)
        })

        contentPre.addEventListener('input', (e) => {
            debouncedContentChange(e.target.textContent)
        })





        socket.on('noteTitleChange', (data) => {
          titlePre.textContent = JSON.parse(data)
        })

        socket.on('noteSummaryChange', (data) => {
          summaryPre.textContent = JSON.parse(data)
        })

        socket.on('noteContentChange', (data) => {
          contentPre.textContent = JSON.parse(data)
        })


</script>
  <script>
    const editBtn = document.querySelector('.edit-btn')
    const submitBtn = document.querySelector('.submit-btn')
    editBtn.addEventListener('click', () => {
      if(editBtn.textContent==='Edit'){
      document.querySelectorAll('pre').forEach(pre => {
        pre.setAttribute('contenteditable', 'true')
      })
      submitBtn.classList.remove('invis')
      editBtn.textContent = "Cancel"
      }else{
      submitBtn.classList.add('invis')
      editBtn.textContent = "Edit"
      document.querySelectorAll('pre').forEach(pre => {
        pre.setAttribute('contenteditable', 'false')
      })
      }
    })

      submitBtn.addEventListener('click', async () => {
          const title = document.querySelector('.noteTitle').textContent
          const summary = document.querySelector('.noteSummary').textContent
          const content = document.querySelector('.noteContent').textContent

          try{
          const res = await fetch(`/collaborations/<%= note.id%>/update`, {
            method: "PUT",
            headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
            body: JSON.stringify({title, summary, content})
          })
            if(!res.ok){
              alert('Failed to update note')
            }else{
              location.reload()
            }
          }catch(e){
            console.log(e)
          }
          
      } )


      //for fetching the existing collaborators
      const fetchCollaborators = async () => {
          const res = await fetch('/collaborations/<%= note.id %>/collaborators')
          const data = await res.json()
          // console.log(data)
          generateCollaboratorsHtml(data)
      }
      fetchCollaborators()

      const collaboratorList = document.querySelector('.collaborator-list')
      
      const generateCollaboratorsHtml = async (data) => {
        let collaboratorsHtml = ''
        data.forEach(collaborator => {
          const username = collaborator.username
          collaboratorsHtml += `
          <div class="collaborator">
            <p>${username} - ${collaborator.permissions}</p>
            <button class="remove-btn" onclick="removeCollaborator('${username}')">remove</button>
          </div>`
        })
        collaboratorList.innerHTML = collaboratorsHtml
      }
      //for rendering the collaborator list
      
      


      //getting value from the addCollaboratorInput and making a POST request
      const addCollaboratorInput = document.querySelector('.collaboratorUsername')
      const collaboratorPermission = document.querySelector('.permission')
          
      const addCollaborator = async () => {
        const userName = String(addCollaboratorInput.value).toLocaleLowerCase()
        const permission = collaboratorPermission.value
        
        if(userName === '') return alert('Input cannot be empty') 
        if(permission === '') return alert('Please select a permission for the collaborator') 
        
        try{
          const res = await fetch(`/collaborations/<%= note.id %>/collaborator/add/${userName}`, {
            method: 'PATCH',
            headers: {
            'Content-Type': 'application/json'
          },
            body: JSON.stringify({permission})
          })
          if(res.ok){
            alert('Collaborator added Sucessfully')
            fetchCollaborators()
          }else {
            if (res.status === 404) alert("User not found")
            if (res.status === 409) alert("User is already a Collaborator")
          }
        }catch(e){
          console.log(e)
        }
      }







      //function for removing certain collaborators
      const removeCollaborator = async(username) =>{
        const userName = username
        try{
          const res = await fetch(`/collaborations/<%= note.id %>/collaborator/remove/${userName}`, {
            method: "DELETE"
          })
          if(!res.ok){
            alert('Failed to remove collaborator.')
          } 
            else alert('Removed the collaborator.')
            fetchCollaborators()
        }catch(e){
          console.log(e)
        }
        
      }

  </script>
</body>
</html>

